# Base URL of the wedding backend. Leave empty to use relative `/api/v1` URLs
# (recommended when the frontend is served behind the same domain / proxy).
VITE_API_BASE_URL=

# Dev only: forward `/api` requests from the Vite dev server to this backend.
# Dev backend: run `npm run dev` inside wedding-api/.
VITE_API_PROXY_TARGET=http://localhost:8080

# Dev only: when "true", use the local sample wedding in src/data/ instead of
# calling the backend. Ignored in production builds.
VITE_USE_SAMPLE_DATA=false

# "Dibuat oleh …" credit at the end of the invitation (build time). Leave the name
# empty to hide it. The link is optional and must start with http(s)://.
VITE_CREDIT_NAME=
VITE_CREDIT_URL=
