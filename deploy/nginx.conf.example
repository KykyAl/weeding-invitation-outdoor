# Nginx in front of the invitation, for when a domain points at the server.
# 1. Copy to /etc/nginx/sites-available/undangan and replace undangan.example.com.
# 2. In production.env set HOST=127.0.0.1, TRUST_PROXY=1 and
#    CORS_ORIGIN=https://undangan.example.com, then re-run deploy.sh.
# 3. sudo ln -s /etc/nginx/sites-available/undangan /etc/nginx/sites-enabled/
#    sudo nginx -t && sudo systemctl reload nginx
# 4. HTTPS: sudo certbot --nginx -d undangan.example.com

server {
    listen 80;
    server_name undangan.example.com;

    client_max_body_size 1m;

    # Gzip the app shell and API responses (assets are already fingerprinted and cached).
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
