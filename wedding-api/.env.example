NODE_ENV=development
PORT=8080
# 0.0.0.0 = all interfaces; use 127.0.0.1 behind Nginx.
HOST=0.0.0.0

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wedding

# Use a long random value in production, e.g. `openssl rand -hex 32`.
JWT_SECRET=change-this-secret
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins.
CORS_ORIGIN=http://localhost:5173

# Used by `npm test` (a separate database; the tests reset it).
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wedding_test

# Set to 1 when running behind one reverse proxy (nginx, Render, Railway…) so
# rate limiting sees the real client IP. Leave 0 when exposed directly.
TRUST_PROXY=0

# Optional: path to the built frontend (`npm run build` in the frontend → dist/).
# When set, this server also serves the invitation pages and fills in link-preview
# (WhatsApp / Open Graph) tags for /wedding/:slug. Leave empty for API-only.
FRONTEND_DIST=
